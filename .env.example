# arb-cockpit — copy to .env.local and fill in. NEVER commit real keys.

# Master safety switch. While true, every step only SIMULATES — no real order,
# withdrawal, or on-chain send. Flip to false once keys + risk limits are tested.
DRY_RUN=true

# Required when DRY_RUN=false: shared secret for money-moving endpoints
# (/api/exec-step). The UI must send it as the x-exec-token header.
EXEC_TOKEN=

# Inject sample opportunities so the board renders without live/KR data.
USE_MOCK=true

# Exchange API keys (semi-auto execution). Read-only market data needs none.
BINANCE_KEY=
BINANCE_SECRET=
UPBIT_KEY=
UPBIT_SECRET=
BYBIT_KEY=
BYBIT_SECRET=

# USD/KRW fallback if no live FX source is wired.
USD_KRW=1390

# ── Personal wallet (FULL-AUTO on-chain transfer) ──────────────────────────────
# ⚠️ SERVER-ONLY. This key can MOVE FUNDS. Never commit. A real broadcast happens
# only when DRY_RUN=false AND this key is set. EVM chains for now.
# Signing keys per chain family (each dormant until set):
WALLET_PRIVATE_KEY=        # EVM (Ethereum/Polygon/Arbitrum/Base/BSC/Avalanche…)
WALLET_XRP_SECRET=         # XRP seed (sXXXX)
WALLET_TRON_KEY=           # TRON private key (hex)
WALLET_SOL_KEY=            # Solana secret (base58 or JSON array)
# EVM RPCs (public defaults built in; override for reliability):
WALLET_RPC_ETHEREUM=https://eth.llamarpc.com
WALLET_RPC_POLYGON=https://polygon-rpc.com
# Read-only balance addresses (EVM derives from key if unset):
WALLET_ADDR_EVM=
WALLET_ADDR_XRP=
WALLET_ADDR_TRON=
WALLET_ADDR_SOL=
# Fallback destination if the exchange deposit-address fetch fails (needs keys).
WALLET_DEPOSIT_FALLBACK=

# OKX Web3 (DEX aggregator) — cex-dex 견적/스왑. 거래 키와 별개, OKX 개발자
# 포털에서 발급. 없으면 cex-dex 전략은 휴면(목업만 표시).
OKX_WEB3_KEY=
OKX_WEB3_SECRET=
OKX_WEB3_PASSPHRASE=

# 텔레그램 알림 — @BotFather로 봇 만들고 토큰, 봇에게 말 건 뒤 chat_id.
# 서버 스캔 루프가 임계 돌파·입출금 중단을 폰으로 푸시(사이트 안 켜도 감시).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 바이비트 (크로스·김프 글로벌 다리 실행). v5 HMAC.
BYBIT_KEY=
BYBIT_SECRET=
# OKX (거래) — DEX 키(OKX_WEB3_*)와 별개의 거래 API 키. v5 HMAC+passphrase.
OKX_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# 수수료 티어 오버라이드 (기본: 빗썸 0.25%는 쿠폰 없는 기본 테이커 — 쿠폰 있으면 0.04)
# BITHUMB_TAKER_PCT=0.04
# BINANCE_TAKER_PCT=0.075   # BNB 할인 시
# 보드 비용 산정 기준 사이즈 / 리패트리에이션 드래그
# BOARD_REF_USD=5000
# REPATRIATION_PCT=0.2

# cex-dex 실행(재고형): OKX_WEB3_*(견적/스왑) + WALLET_PRIVATE_KEY(EVM 서명) 필요.
# 재고형이라 양쪽(지갑에 스테이블+토큰, CEX에 반대)을 미리 채워둬야 동시 발사됨.

# 상장따리: 텔레그램 공개채널 스크레이프 폴백(CF·IP 무관). t.me/s/<채널명>의
# 채널명. 업비트 공식 or 신뢰하는 상장알림 채널. 비우면 비활성.
LISTING_TG_CHANNEL=
# 상장따리 원클릭 매수 기본 규모 (USD)
LISTING_BUY_USD=500

# ── 모의(DRY_RUN) 정교화 — lib/simEnv.ts ─────────────────────────────────────
# SIM_TIME_SCALE=60        # 전송 ETA 압축 배율 (60 = 15분 ETA가 15초; 1 = 실시간)
# SIM_STEP_LATENCY_MS=800  # 주문류 단계당 인위 지연 ms (0 = 즉시)
# SIM_BOOK_FILLS=1         # 1 = 실호가 VWAP 모의체결(수수료·슬리피지 반영), 0 = 스냅샷가
# SIM_FAIL_PCT=0           # 중간 단계 실패 확률 주입 % — 롤백·브레이커 리허설용

# ── 자동 매도 트리거 (lib/sellTriggers.ts) ──────────────────────────────────
# 등록은 운영 탭 카드에서. 라이브 등록/취소는 EXEC_TOKEN 필요.
# 모드: 시장가/호가/지정가 · 발화: hybrid(잔고확인 후 주문·안전) / hammer(계속 던짐·최속)
# hammer는 거절 주문을 쏘므로 거래소 abuse 감시 위험 — 페이싱은 코드 POLL_MS(250ms).

# 온체인 전송 컨펌 대기 상한(ms). ethers wait()는 기본 무한 대기라, 가스가 낮게
# 잡히거나 체인이 막히면 전송 단계가 영영 안 끝나고 런이 busy에 갇혔다. 시간이
# 차면 해시를 든 채 "브로드캐스트됨(컨펌 미확인)"으로 사람에게 넘긴다.
WALLET_TX_WAIT_MS=900000

# ── 외부 노출 (선택) ─────────────────────────────────────────────────────────
# 이 앱엔 로그인이 없다. 루프백 밖으로 열려면(start:lan, 공인 IP) 반드시 둘 다:
# BASIC_AUTH — 화면·API 전부 잠금 (GET /api/health만 예외: 헬스체크 크론용).
# ALLOWED_HOSTS — 출처 확인이 공인 Host를 리바인딩으로 보고 막으므로, 접속에 쓸
#   host[:port]를 콤마로 명시. 목록 밖 Host는 여전히 거부된다.
BASIC_AUTH=
ALLOWED_HOSTS=

# ── 입출금 재개 대응 (lib/reopen.ts) ─────────────────────────────────────────
# 잠긴 코인 고속 감시 주기(ms)와 재개 예정 5분 전 고속 주기. 거래소 한도가 걱정되면 늘린다.
GATE_WATCH_MS=10000
GATE_WATCH_FAST_MS=3000
# 빗썸 공지 API — 기본값이 안 맞으면 여기서 교체
BITHUMB_NOTICE_URL=
