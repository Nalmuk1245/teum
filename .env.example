# arb-cockpit — copy to .env.local and fill in. NEVER commit real keys.

# Master safety switch. While true, every step only SIMULATES — no real order,
# withdrawal, or on-chain send. Flip to false once keys + risk limits are tested.
DRY_RUN=true

# Required when DRY_RUN=false: shared secret for money-moving endpoints
# (/api/exec-step). The UI must send it as the x-exec-token header.
EXEC_TOKEN=

# Inject sample opportunities so the board renders without live/KR data.
USE_MOCK=true

# Exchange API keys (semi-auto execution). Read-only market data needs none.
BINANCE_KEY=
BINANCE_SECRET=
UPBIT_KEY=
UPBIT_SECRET=
BYBIT_KEY=
BYBIT_SECRET=

# USD/KRW fallback if no live FX source is wired.
USD_KRW=1390

# ── Personal wallet (FULL-AUTO on-chain transfer) ──────────────────────────────
# ⚠️ SERVER-ONLY. This key can MOVE FUNDS. Never commit. A real broadcast happens
# only when DRY_RUN=false AND this key is set. EVM chains for now.
# Signing keys per chain family (each dormant until set):
WALLET_PRIVATE_KEY=        # EVM (Ethereum/Polygon/Arbitrum/Base/BSC/Avalanche…)
WALLET_XRP_SECRET=         # XRP seed (sXXXX)
WALLET_TRON_KEY=           # TRON private key (hex)
WALLET_SOL_KEY=            # Solana secret (base58 or JSON array)
# EVM RPCs (public defaults built in; override for reliability):
WALLET_RPC_ETHEREUM=https://eth.llamarpc.com
WALLET_RPC_POLYGON=https://polygon-rpc.com
# Read-only balance addresses (EVM derives from key if unset):
WALLET_ADDR_EVM=
WALLET_ADDR_XRP=
WALLET_ADDR_TRON=
WALLET_ADDR_SOL=
# Fallback destination if the exchange deposit-address fetch fails (needs keys).
WALLET_DEPOSIT_FALLBACK=

# OKX Web3 (DEX aggregator) — cex-dex 견적/스왑. 거래 키와 별개, OKX 개발자
# 포털에서 발급. 없으면 cex-dex 전략은 휴면(목업만 표시).
OKX_WEB3_KEY=
OKX_WEB3_SECRET=
OKX_WEB3_PASSPHRASE=

# 텔레그램 알림 — @BotFather로 봇 만들고 토큰, 봇에게 말 건 뒤 chat_id.
# 서버 스캔 루프가 임계 돌파·입출금 중단을 폰으로 푸시(사이트 안 켜도 감시).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 바이비트 (크로스·김프 글로벌 다리 실행). v5 HMAC.
BYBIT_KEY=
BYBIT_SECRET=
# OKX (거래) — DEX 키(OKX_WEB3_*)와 별개의 거래 API 키. v5 HMAC+passphrase.
OKX_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
